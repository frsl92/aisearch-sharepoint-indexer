# no_embedding | image_embeddings | text_embeddings | all_embeddings
DEPLOYMENT_TYPE=no_embedding

# Azure AI Search. Blank key = system-assigned identity of the machine running Python.
SEARCH_ENDPOINT=https://flopes-switz-aisearch.search.windows.net
SEARCH_ADMIN_KEY=
# Base name. Each type gets a separate index, e.g. sharepoint-rag-no-embedding.
SEARCH_INDEX_NAME=sharepoint-rag
# Optional base-name overrides; all final names include the deployment type.
# Blank = <SEARCH_INDEX_NAME>-<type>-datasource/-skillset/-indexer.
SEARCH_DATASOURCE_NAME=
SEARCH_SKILLSET_NAME=
SEARCH_INDEXER_NAME=

# SharePoint app authentication. Blank secret = federation from the SEARCH SERVICE identity.
SHAREPOINT_SITE_URL=https://mngenvmcap609094.sharepoint.com/sites/DocumentHub
SHAREPOINT_APPLICATION_ID=f4cc82e6-df50-4997-a7a2-dd38108d3025
SHAREPOINT_TENANT_ID=bd94f702-4255-45ae-9ec6-62155bcd308e
SHAREPOINT_APPLICATION_SECRET=
SEARCH_IDENTITY_CLIENT_ID=f0f5239e-3c05-40ce-8fed-696fad24bfec
# Optional: exact library URL. Blank = the site's default document library.
SHAREPOINT_LIBRARY_URL=

# Only needed for text_embeddings and all_embeddings.
# Existing text-embedding-3-large deployment (3072 dimensions).
AZURE_OPENAI_ENDPOINT=https://flopes-swc-foundry.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_KEY=

# Only needed for image_embeddings and all_embeddings.
# Multi-service resource for OCR, Vision image embeddings and the image query vectorizer.
AZURE_AI_SERVICES_ENDPOINT=https://flopes-cogserv.cognitiveservices.azure.com
AZURE_AI_SERVICES_KEY=

# Hourly incremental indexing. Blank = no schedule.
INDEXER_SCHEDULE=
