# Azure deployment target.
# Required: GUID of the subscription in which Bicep creates the resource group,
# Search service, Foundry account and model deployment.
AZURE_SUBSCRIPTION_ID="<subscription-guid>"
# Optional: existing or dedicated resource group name. Leave blank to use
# rg-<AZURE_ENV_NAME>; use a different resource group for dev, qa and prod.
AZURE_RESOURCE_GROUP=""
# Required: Azure region for AI Search. Foundry uses this region unless
# FOUNDRY_LOCATION is set. Check Search, embedding-model and SKU availability.
AZURE_LOCATION="polandcentral"
# Optional tenant override when the subscription is in a different directory
# than the azd sign-in tenant. Set to a tenant GUID; automatic federation needs
# this to match SHAREPOINT_TENANT_ID. Normally azd resolves it.
# AZURE_TENANT_ID="<azure-tenant-guid>"

# Selects which SharePoint indexer/skillset pipeline is created:
#   no_embedding | image_embeddings | text_embeddings | all_embeddings
# text_embeddings and all_embeddings use text-embedding-3-large.
# image_embeddings and all_embeddings use Vision/OCR. Each mode gets separate
# Search object names with the mode appended as a suffix.
DEPLOYMENT_TYPE="text_embeddings"

# SharePoint ingestion app and site. Create/configure this app separately; Bicep
# does not create it or grant Microsoft Graph permissions/consent.
# Required: tenant GUID where the SharePoint site and ingestion app live.
# Automatic federation currently requires this to match AZURE_TENANT_ID.
SHAREPOINT_TENANT_ID="<sharepoint-tenant-guid>"
# Required: HTTPS URL of the SharePoint site, e.g.
# https://contoso.sharepoint.com/sites/DocumentHub
# Do not put a document-library URL here; use SHAREPOINT_LIBRARY_URL below.
SHAREPOINT_SITE_URL="<sharepoint-site-url>"
# Required: client/application ID GUID of the SharePoint ingestion app.
# This is NOT the Search managed identity's client ID.
SHAREPOINT_APPLICATION_ID="<sharepoint-app-client-guid>"
# Optional secret-based authentication. Leave blank to use federation from the
# Search managed identity. If used, keep the value in a secure secret store and
# leave CONFIGURE_SHAREPOINT_FEDERATION=false.
# SHAREPOINT_APPLICATION_SECRET=""
# Optional: exact library URL within SHAREPOINT_SITE_URL. Blank means the site's
# default document library. The connector uses includeLibrary filtering.
# SHAREPOINT_LIBRARY_URL=""

# Embedding deployment. The model family is currently fixed to
# text-embedding-3-large; this sets its Azure deployment name, not model name.
# Bicep creates this deployment for every DEPLOYMENT_TYPE; the Search pipeline
# uses it for text_embeddings and all_embeddings.
# Bicep also writes the resolved name back to the azd environment.
AZURE_OPENAI_DEPLOYMENT="text-embedding-3-large"
# Model version available in FOUNDRY_LOCATION for the chosen SKU.
EMBEDDING_MODEL_VERSION="1"
# Deployment quota capacity units (not a raw tokens-per-minute setting).
# Confirm model/region quota before deployment; this example requests 20 units.
EMBEDDING_CAPACITY="20"

# AI Search service options.
# basic | standard | standard2 | standard3 | serverless
# Serverless is a preview and requires Microsoft.Search/Serverless feature
# registration in the subscription; the pre-provision hook registers it when
# this SKU is selected. Availability is region- and subscription-dependent.
SEARCH_SKU="basic"
# disabled | free | standard. Semantic ranking availability/limits depend on
# Search SKU and service configuration.
SEARCH_SEMANTIC_SEARCH="standard"
# Required when CONFIGURE_SEARCH_PIPELINE=true. Base name only: the deployment
# type suffix is appended automatically (e.g. sharepoint-rag-text-embeddings).
# Use lowercase letters, digits and hyphens; avoid consecutive hyphens.
SEARCH_INDEX_NAME="sharepoint-rag"
# Optional indexer schedule as an ISO 8601 duration, e.g. PT15M, PT1H, PT24H.
# Supported range is 5 minutes to 24 hours. Blank disables scheduled runs;
# the indexer can still be run manually.
INDEXER_SCHEDULE=""

# Post-provision stages run in order after Bicep. Each flag independently
# controls its stage; true enables the stage and false disables it.
# true adds/reuses the app's federated credential named after the Search service,
# or updates its subject if Search was recreated (same issuer, audience and
# script-generated environment description required), and saves the client ID.
# Requires Microsoft Graph permissions
# to read the identity and update the app; subscription Contributor is not enough.
CONFIGURE_SHAREPOINT_FEDERATION="false"
# true verifies the SharePoint authentication and creates/updates the Search
# data source, index, skillset and indexer. Federation must already exist unless
# SHAREPOINT_APPLICATION_SECRET is supplied. Defaults to true in the hook, but
# this example leaves it disabled for infrastructure-only setup.
CONFIGURE_SEARCH_PIPELINE="false"

# Optional infrastructure overrides (uncomment to set):
# FOUNDRY_LOCATION=""                 # Defaults to AZURE_LOCATION.
# AZURE_PRINCIPAL_TYPE="User"         # User | ServicePrincipal; use ServicePrincipal for CI identities.
# SEARCH_REPLICA_COUNT="1"            # Dedicated SKUs only; Basic supports at most 3.
# SEARCH_PARTITION_COUNT="1"          # 1 | 2 | 3 | 4 | 6 | 12, subject to SKU/region limits.
# EMBEDDING_SKU="Standard"            # Deployment SKU; verify availability for model/region.

# Optional Search object-name overrides. Leave unset to derive names from
# SEARCH_INDEX_NAME. The deployment-type suffix is appended to each base name.
# SEARCH_DATASOURCE_NAME=""
# SEARCH_SKILLSET_NAME=""
# SEARCH_INDEXER_NAME=""

# Optional authentication keys for an existing Search/AI resource when its
# local/key authentication is enabled. Keys override managed-identity auth.
# The resources created by this Bicep template disable local authentication, so
# these keys are not usable for those resources. Never commit real key values.
# SEARCH_ADMIN_KEY=""                  # Search admin key, not query key; Python -> Search.
# AZURE_OPENAI_KEY=""                  # Azure OpenAI key; Search -> embedding skill/vectorizer.
# AZURE_AI_SERVICES_KEY=""             # Multi-service key; Search -> OCR/Vision skills/vectorizer.

# Values normally produced by azd/Bicep outputs; don't set for a new deployment:
# AZURE_TENANT_ID                       # Tenant used by this subscription/deployment.
# AZURE_PRINCIPAL_ID                    # User/service-principal object ID running azd.
# AZURE_SEARCH_SERVICE_NAME             # Provisioned Search service name.
# SEARCH_ENDPOINT                       # Provisioned Search endpoint.
# SEARCH_IDENTITY_PRINCIPAL_ID          # Search system identity object/principal ID.
# SEARCH_IDENTITY_CLIENT_ID             # Search identity client ID; post-provision stages resolve/save it after trust verification.
# AZURE_AI_ACCOUNT_NAME                 # Provisioned Foundry account name.
# AZURE_OPENAI_ENDPOINT                 # Provisioned Foundry OpenAI endpoint.
# AZURE_AI_SERVICES_ENDPOINT            # Provisioned multi-service AI endpoint for image/OCR skills.

# azd environment name is selected by `azd env new/select`; it controls the
# default resource group, resource tags and deployment environment.
# AZURE_ENV_NAME="dev"
# Use a separate azd environment for each of dev, qa and prod.
